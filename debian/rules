#!/usr/bin/make -f

export PYBUILD_NAME = qpy-rsync

NB_BUILD = $(CURDIR)/debian/native-hybrid-build

%:
	dh $@ --with python3 --buildsystem=pybuild

override_dh_auto_build:
	dh_auto_build
	# Build the optional native Qt view extension against the system Qt6.
	# debian/install copies it from $(NB_BUILD) into the package staging tree.
	cmake -S native-hybrid -B $(NB_BUILD) -G Ninja \
	  -DPYTHON_EXECUTABLE=$$(command -v python3) -DCMAKE_BUILD_TYPE=Release
	cmake --build $(NB_BUILD)

# The test suite starts Qt applications; it runs in the repository, not
# during a package build.
override_dh_auto_test:
